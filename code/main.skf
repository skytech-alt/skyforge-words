// skyforge-words

функция посчитать_слова(текст) {
    пусть слова = разбить(текст, " ")
    пусть счетчик = 0
    для с в слова {
        если длина(с) > 0 { счетчик = счетчик + 1 }
    }
    вернуть счетчик
}

функция время_чтения(текст) {
    пусть слова = посчитать_слова(текст)
    если слова == 0 { вернуть "0 min read" }
    пусть минуты = пол(слова / 200)
    если минуты < 1 { минуты = 1 }
    вернуть строка(минуты) + " min read"
}
